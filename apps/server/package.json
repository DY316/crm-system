{
  "name": "@crm/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate --config prisma/prisma.config.cjs",
    "db:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.cjs",
    "db:seed": "prisma db seed --config prisma/prisma.config.cjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.15.6",
    "prisma": "7.8.0",
    "typescript": "^5.7.2"
  }
}
